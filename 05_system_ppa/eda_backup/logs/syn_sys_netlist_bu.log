    set c [get_cells $inst]
    set r [get_attribute $c ref_name]
    set unmapped_cnt [sizeof_collection [get_cells -quiet -hier -filter "full_name =~ ${inst}/* && is_hierarchical == false && is_unmapped == true"]]
